# ==========================================
# NovaGates Backend & AI Platform Environment
# Copy this file to .env before starting services
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="NovaGates Portfolio & AI Service"

# MongoDB Database Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB_NAME=portfolio_db
MONGODB_URI=mongodb://localhost:27017/portfolio_db

# Redis Cache & Broker Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300

# Celery Task Queue
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI & External APIs
TAVILY_API_KEY=tvly-placeholder-your-key-here
OPENAI_API_KEY=sk-placeholder-your-key-here
